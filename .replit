modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Geocode Dealers"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Daily MRP Sync"

[[workflows.workflow]]
name = "Geocode Dealers"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server && node scripts/geocode-dealers.mjs"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Daily MRP Sync"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "while true; do pnpm --filter @workspace/scripts run sync-external-mrp; echo 'Next sync in 24h...'; sleep 86400; done"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["google-drive:1.0.0", "google-mail:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 20948
externalPort = 3000

[nix]
channel = "stable-25_05"
